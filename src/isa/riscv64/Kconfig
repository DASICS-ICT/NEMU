menu "ISA-dependent Options for riscv64"

config CLINT_MMIO
  hex "MMIO address of CLINT"
  default 0xa2000000

config MULTICORE_DIFF
  bool "(Beta) Enable multi-core difftest APIs for RISC-V"
  default false

config RVB
  bool "RISC-V Bitmanip Extension v1.0"
  default y

config RVK
  bool "RISC-V Cryptography Extension v1.0"
  default y

config RVV
  bool "RISC-V Vector Extension v1.0"
  default y

config RVN
  bool "RISC-V User-Level Interrupts Extension v1.1"
  default y

config RV_DEBUG
  bool "RISC-V Debug Extension"
  default y

config RV_DASICS
  bool "Enable DASICS Protection Mechanism for RV64"
  default y

config RV_ZICFILP
  bool "Enable RISC-V Zicfilp Extension (Landing Pad for CFI)"
  default n
  help
    Enable support for RISC-V Zicfilp (Control-Flow Integrity Landing Pad)
    extension. This provides forward-edge control flow integrity through
    landing pad instructions that mark valid indirect jump/call targets.

    When enabled, indirect jumps and calls must target valid landing pad
    (LPAD) instructions, preventing Return-Oriented Programming (ROP) attacks.

    Ratified as part of RISC-V privileged specification v1.13.

    If unsure, say N.

config RV_ZICFILP_LABEL_CHECK
  depends on RV_ZICFILP
  bool "Enable landing pad label checking"
  default y
  help
    Enable strict label matching for landing pads using the x7 register.
    When enabled, the landing pad label must match the expected value
    stored in x7, providing stronger control flow integrity guarantees.

    This adds additional overhead but increases security.

    If unsure, say Y.

config RV_PMP_CSR
  bool "Enable PMP CSR Read & Write"
  default y

config RV_PMP_NUM
  depends on RV_PMP_CSR
  int "Number of PMP CSR registers"
  default 16
  range 0 16

config RV_PMP_CHECK
  # todo: pmp check still not work when enable PERF_OPT
  depends on !PERF_OPT
  depends on RV_PMP_CSR
  bool "Enable PMP Check"
  default y

config RV_SVINVAL
  bool "Enable VM Extension Svinval"
  default y

config MISA_UNCHANGEABLE
  bool "Make misa cannot be changed by CSR write instructions like XS"
  default y

config XTVEC_VECTORED_MODE
  bool "Support Vectored MODE of mtvec/stvec"
  default y

config RV_ARCH_CSRS
  bool "Enable mvendorid, marchid, mimpid CSR"
  default y

config USE_XS_ARCH_CSRS
  depends on RV_ARCH_CSRS
  bool "Use the same arch CSRS values as the implementation of XiangShan"

config MVENDORID_VALUE
  depends on RV_ARCH_CSRS
  depends on !USE_XS_ARCH_CSRS
  hex "Value of CSR mvendorid"
  default 0x0

config MARCHID_VALUE
  depends on RV_ARCH_CSRS
  depends on !USE_XS_ARCH_CSRS
  hex "Value of CSR marchid"
  default 0x0

config MIMPID_VALUE
  depends on RV_ARCH_CSRS
  depends on !USE_XS_ARCH_CSRS
  hex "Value of CSR mimpid"
  default 0x0

endmenu
